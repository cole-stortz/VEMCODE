# No canvas-injection verb exercises the framebuffer headlessly, same as
# Max7219Test/NeoPixelTest -- this only confirms all 3 sketch-declared OLEDs
# (none with a dedicated reset pin, so each gets its own synthetic I2C-bus
# pin -- see src/core/circuit/i2cbus.h) get detected and load without
# crashing, and that the shared loop()'s frame counter advances correctly.
0.2, ASSERT, SERIAL_CONTAINS, "All 3 OLEDs ready"
0.4, ASSERT, SERIAL_CONTAINS, "frame x=0"
0.6, ASSERT, SERIAL_CONTAINS, "frame x=5"
